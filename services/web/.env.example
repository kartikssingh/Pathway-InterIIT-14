# Copy to `.env.local` (Next.js reads that file and it is git-ignored).
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time. Never put a secret here.

# Base URL of the compliance API. Must match where `services/api` is listening.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001

# Milliseconds before an API request is aborted.
NEXT_PUBLIC_API_TIMEOUT_MS=20000

# Shown in the header so it is obvious which environment you are looking at.
NEXT_PUBLIC_ENVIRONMENT=development
