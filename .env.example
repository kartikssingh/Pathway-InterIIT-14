# =============================================================================
# FraudGuard — one environment file for the whole stack.
#
#   cp .env.example .env    then fill in what you need.
#
# Each service reads this file from the repository root (and its own directory,
# if present). Nothing here is required to *import* any module — a missing key
# only stops the specific flow that needs it, and `python -m fraudguard doctor`
# tells you exactly which.
#
# Never commit the filled-in .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
APP_ENV=development           # development | production — production enforces strict validation
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                # true emits newline-delimited JSON logs for a log shipper

# -----------------------------------------------------------------------------
# PostgreSQL  (required by: api, db-sink, rps-features, mcp-agent, watchdog)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=values_db
POSTGRES_DBNAME=values_db     # historical alias; either name works
POSTGRES_USER=user
POSTGRES_PASSWORD=            # REQUIRED — also used by docker compose
POSTGRES_POOL_SIZE=10

# The API can take a full URL instead of the parts above.
# DATABASE_URL=postgresql://user:password@localhost:5432/values_db

# -----------------------------------------------------------------------------
# Kafka  (required by: every streaming flow)
# -----------------------------------------------------------------------------
BOOTSTRAP_SERVERS=localhost:9092
GROUP_ID=fraudguard           # each flow appends its own suffix
SESSION_TIMEOUT_MS=6000
AUTO_OFFSET_RESET=earliest
KAFKA_AUTOCOMMIT_MS=100

# Topics
MAIN_BACKEND_TOPIC=entities
DB_TOPIC=db_updates
RPS_FEATURES_TOPIC=rps_processed_features
FRAUD_TOPIC=possible_fraud
TRANSACTIONS_CDC_TOPIC=postgres.public.transactions

# Infrastructure ports (docker compose)
KAFKA_EXTERNAL_PORT=9092
DEBEZIUM_PORT=8083
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Compliance data sources
# -----------------------------------------------------------------------------
OS_API_KEY=                   # OpenSanctions — https://api.opensanctions.org
SANCTIONS_API_KEY=            # OFAC          — https://www.ofac-api.com
OTX_API_KEY=                  # AlienVault OTX — source reputation (optional)

# Google Programmable Search, for adverse-media discovery.
# Key n is always used with engine n; add as many numbered pairs as you have.
GOOGLE_CLOUD_API_KEY_1=
PROGRAMMABLE_SEARCH_ENGINE_ID_1=
GOOGLE_CLOUD_API_KEY_2=
PROGRAMMABLE_SEARCH_ENGINE_ID_2=

ADVERSE_KEYWORDS=fraud,scam   # comma-separated; each is searched with the subject name
SEARCH_RESULTS_PER_QUERY=2
HTTP_TIMEOUT_S=30
HTTP_RETRIES=3

# -----------------------------------------------------------------------------
# LLM  (required by: kyc-enrichment, rps-explain, rag-server)
# -----------------------------------------------------------------------------
MISTRAL_KEY=
LLM_MODEL=mistral/mistral-small-latest
EMBEDDING_MODEL=mistral/mistral-embed
EMBEDDING_API_KEY=            # defaults to MISTRAL_KEY
CROSS_ENCODER_MODEL=          # optional reranker for the RAG server
LLM_MAX_RETRIES=4
LLM_TIMEOUT_S=60

# Content guardrails. Set to false to skip validation entirely; when the
# guardrails packages are not installed the pipeline warns once and continues.
GUARDRAILS_ENABLED=true
GUARDRAILS_TOXICITY_THRESHOLD=0.5

# Agent (CrewAI) — used by mcp-agent
GEMINI_API_KEY=
AGENT_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Pathway
# -----------------------------------------------------------------------------
PW_LICENSE=                   # required only by the MCP server; free key at pathway.com/features
PATHWAY_MCP_URL=http://localhost:8123/mcp/

# -----------------------------------------------------------------------------
# Scoring service
# -----------------------------------------------------------------------------
RPS_API_HOST=127.0.0.1
RPS_API_PORT=9000
SCORE_URL=http://127.0.0.1:9000/score
RAG_URL=http://127.0.0.1:8000/v2/answer
# RPS_LEGACY_LOGIT=true       # reproduce scores generated before the logit() fix

# -----------------------------------------------------------------------------
# KYC document intake (AWS S3 + Google Document AI) — optional
# -----------------------------------------------------------------------------
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=              # bucket holding uploaded forms
AWS_FORMS_PREFIX=forms/pending/
AWS_PROFILEPIC_BUCKET=
AWS_S3_BUCKET=                # bucket the API uploads to (usually AWS_BUCKET_NAME)

PROCESSOR_NAME=               # projects/<id>/locations/us/processors/<processor-id>
GOOGLE_APPLICATION_CREDENTIALS=   # absolute path to the service-account JSON

# -----------------------------------------------------------------------------
# API service
# -----------------------------------------------------------------------------
SECRET_KEY=                   # REQUIRED in production: openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
TRUST_PROXY_HEADERS=false     # only enable behind a proxy you control

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_DB=0
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Web console  (also copy services/web/.env.example to services/web/.env.local)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
